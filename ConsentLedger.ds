		workflow
		{
		form
		{
			Log_Consent_Creation as "Log_Consent_Creation"
			{
				type =  form
				form = Consent_Records

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											uniqueID = "Consent_Created_" + input.ID + "_" + zoho.currenttime.toString("yyyyMMddHHmmss");
										insert into Action_Log
										[
											Action_Reference_ID=uniqueID
											Action_Date_Time=zoho.currenttime
											Action_Type="Consent Created"
											Related_Record_Type="Consent"
											Related_Record_ID=input.ID
											Action_Details="A new consent record was created with ID " + input.ID
											Added_User=zoho.loginuser
										]
						)
					}
				}

			}
			ML_High_Risk_Email_Alert as "ML_High_Risk_Email_Alert"
			{
				type =  form
				form = Breach_Incidents

				record event = on add

				on success
				{
					actions  (Risk_Category_Prediction == "High")
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "samdevaraja.j.2024.cse@rajalakshmi.edu.in"
							subject : "High-Risk Breach Incident Detected"
							message : "<p><span>A high-risk breach incident has been identified by ConsentLedger's ML prediction model.</span><br></p><p><br></p><div><span>Incident:&nbsp;${Incident_Title}</span><br></div><div><span>Incident Reference:&nbsp;${Incident_Reference_ID}</span><br></div><div><span>Severity:&nbsp;${Severity}</span><br></div><div><span>Affected Records:&nbsp;${Affected_Records_Estimate}</span><br></div><div><span>Predicted Risk Category:&nbsp;${Risk_Category_Prediction}</span><br></div><div><span>Incident Status:&nbsp;${Incident_Status}</span><br></div><p><br></p><p><span>Please review this incident promptly, verify the predicted risk, and take appropriate containment and response actions.</span><br></p><p><span>This is an automated alert. The ML prediction is an assessment aid and must be reviewed by an authorized officer.</span><br></p><div><br></div>"
						)
					}
					actions  (Risk_Category_Prediction == "High")
					{
					pushnotification
					(
						sender type : "users"
						to : "samdevaraja.j.2024.cse@rajalakshmi.edu.in"
						title : "URGENT: High-Risk Breach Detected"
						message : "A high-risk breach incident has been detected in ConsentLedger. Please open the Breach Incidents report and review the incident immediately."
						view: "Breach_Incidents_Report"
					)
					}
				}

			}
			Calculate_Risk_On_Severit as "Calculate_Risk_On_Severity"
			{
				type =  form
				form = Breach_Incidents

				record event = on add or edit

				on user input of Severity
				{
					actions 
					{
						custom deluge script
						(
											riskScore = 0;
										if(input.Severity == "Low")
										{
											riskScore = 1;
										}
										else if(input.Severity == "Medium")
										{
											riskScore = 3;
										}
										else if(input.Severity == "High")
										{
											riskScore = 6;
										}
										else if(input.Severity == "Critical")
										{
											riskScore = 8;
										}
										if(input.Affected_Records_Estimate != null && input.Affected_Records_Estimate >= 100)
										{
											riskScore = riskScore + 2;
										}
										else if(input.Affected_Records_Estimate != null && input.Affected_Records_Estimate >= 10)
										{
											riskScore = riskScore + 1;
										}
										if(riskScore > 10)
										{
											riskScore = 10;
										}
										input.Risk_Score = riskScore;
						)
					}
				}

			}
			Calculate_Risk_On_Affecte as "Calculate_Risk_On_Affected_Records"
			{
				type =  form
				form = Breach_Incidents

				record event = on add or edit

				on user input of Affected_Records_Estimate
				{
					actions 
					{
						custom deluge script
						(
											riskScore = 0;
										if(input.Severity == "Low")
										{
											riskScore = 1;
										}
										else if(input.Severity == "Medium")
										{
											riskScore = 3;
										}
										else if(input.Severity == "High")
										{
											riskScore = 6;
										}
										else if(input.Severity == "Critical")
										{
											riskScore = 8;
										}
										if(input.Affected_Records_Estimate != null && input.Affected_Records_Estimate >= 100)
										{
											riskScore = riskScore + 2;
										}
										else if(input.Affected_Records_Estimate != null && input.Affected_Records_Estimate >= 10)
										{
											riskScore = riskScore + 1;
										}
										if(riskScore > 10)
										{
											riskScore = 10;
										}
										input.Risk_Score = riskScore;
						)
					}
				}

			}
			Classify_Rights_Request as "Classify_Rights_Request"
			{
				type =  form
				form = Rights_Requests

				record event = on add or edit

				on user input of Request_Text
				{
					actions 
					{
						custom deluge script
						(
											requestText = ifnull(input.Request_Text,"").toLowerCase();
										suggestedType = "Other";
										if(requestText.contains("access") || requestText.contains("copy") || requestText.contains("provide my data") || requestText.contains("personal information"))
										{
											suggestedType = "Access";
										}
										else if(requestText.contains("correct") || requestText.contains("update") || requestText.contains("inaccurate"))
										{
											suggestedType = "Correction";
										}
										else if(requestText.contains("erase") || requestText.contains("delete") || requestText.contains("remove my data"))
										{
											suggestedType = "Erasure";
										}
										input.AI_Suggested_Type = suggestedType;
										input.Classification_Status = "Pending Review";
						)
					}
				}

			}
			Assess_Request_Deadline_R as "Assess_Request_Deadline_Risk"
			{
				type =  form
				form = Rights_Requests

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Request_Status != "Completed" && input.Request_Status != "Closed" && input.Request_Status != "Rejected")
										{
											if(input.Due_Date == null)
											{
												input.Delay_Risk_Level = "Not Assessed";
												input.Risk_Reason = "Due date is missing; review required.";
											}
											else
											{
												daysLeft = daysBetween(zoho.currentdate,input.Due_Date);
												if(daysLeft < 0)
												{
													input.Delay_Risk_Level = "High";
													input.Risk_Reason = "Request is overdue.";
												}
												else if(daysLeft <= 2)
												{
													input.Delay_Risk_Level = "Medium";
													input.Risk_Reason = "Due date is within 2 days.";
												}
												else
												{
													input.Delay_Risk_Level = "Low";
													input.Risk_Reason = "More than 2 days remain before the due date.";
												}
											}
										}
										else
										{
											input.Delay_Risk_Level = "Not Assessed";
											input.Risk_Reason = "Request is closed or completed; no pending deadline risk.";
										}
						)
					}
				}

			}
		}






	}
