 application "Hotel Room Booking Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form Room_Booking_Form
		{
			displayname = "Room Booking Form"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Guest_Name
			(
    			type = name
				displayname = "Guest Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			Email_Address
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Permanent_Address
			(
    			type = address
				displayname = "Permanent Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			Contact_Number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			ID_Proof_Number
			(
    			type = text
				displayname = "ID Proof Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Special_Requests
			(
    			type = textarea
				displayname = "Special Requests"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Number_Of_Guests
			(
				type = number
				displayname = "Number Of Guests"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			Check_In_Date
			(
    			type = date
				displayname = "Check In Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Checkin_Time
			(
    			type = time
				displayname = "Preferred Checkin Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			Room_Type
			(
				type = picklist
				displayname = "Room Type"
				values = {"Standard Single Room","Deluxe Double Room","Standard Double Room"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meal_Plan
			(
				type = picklist
				displayname = "Meal Plan"
				values = {"Breakfast Included","Room Only","All Meals Included"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Amenities_Required
			(
				type = list	
				displayname = "Amenities Required"
				values = {"Extra Bed","Airport Pickup","Late Checkout"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Agree_To_Hotel_Policies
			(
    			type = checkbox
				displayname = "Agree To Hotel Policies"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Requires_Airport_Pickup
			(
    			type = checkbox
				displayname = "Requires Airport Pickup"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hotel_Policies_Display
			(
    			type = textarea
				displayname = "Hotel Policies Display"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Travel_Itinerary_URL
			(
    			type = url
				displayname = "Travel Itinerary URL"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Guest_Photo
			(
    			type = text
				displayname = "Guest Photo"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Loyalty_Discount_Percent
			(
    			type = percentage
				displayname = "Loyalty Discount Percent"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			Advance_Payment_Paid
			(
				displayname = "Advance Payment Paid"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			Distance_From_Airport_KM
			(
				type = decimal
				displayname = "Distance From Airport KM"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			Booking_Submitted_On
			(
    			type = datetime
				displayname = "Booking Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Additional_Guests_Details
			(
    			type = text
				displayname = "Additional Guests Details"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Room_Type_Availability_Lookup
			(
				type = picklist	
				displayname = "Room Type Availability Lookup"
				values  = Room_Inventory.ID
    			displayformat = [room_type_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Guest_Digital_Signature
			(
    			type = text
				displayname = "Guest Digital Signature"
	 			row = 1
	 			column = 1   
				width = medium
			)
			ID_Proof_Upload
			(
    			type = text
				displayname = "ID Proof Upload"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Special_Request_Voice_Note
			(
    			type = text
				displayname = "Special Request Voice Note"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Celebration_Request_Video
			(
    			type = text
				displayname = "Celebration Request Video"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Booking_ID
			(
    			type = autonumber
				displayname = "Booking ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Amount_Payable
			(
				displayname = "Total Amount Payable"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			Booking_Confirmation_QR_Code
			(
    			type = text
				displayname = "Booking Confirmation QR Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Booking Initiated","Pending Validation","Room Availability Checked","Booking Rejected","Pending Approval","Booking Confirmed","Pending Manual Review","Pre-Arrival Preparation","Booking Cancelled","Guest Arrived","Check-In Complete","Guest Stay Active","Check-Out Initiated","Booking Closed"}
			}
		}
		form Room_Inventory
		{
			displayname = "Room Inventory"
			success message = "Room Inventory Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			room_type_code
			(
    			type = text
				displayname = "Room Type Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			room_type_name
			(
				type = picklist
				displayname = "Room Type Name"
				values = {"Standard Single Room","Deluxe Double Room","Standard Double Room"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			tariff_per_night
			(
				displayname = "Tariff Per Night"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			availability_status
			(
				type = picklist
				displayname = "Availability Status"
				values = {"Occupied","Available","Maintenance"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			room_number
			(
    			type = text
				displayname = "Room Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			floor
			(
				type = number
				displayname = "Floor"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			max_occupancy
			(
				type = number
				displayname = "Max Occupancy"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			amenities_list
			(
				type = list	
				displayname = "Amenities List"
				values = {"Extra Bed","Airport Pickup","Late Checkout","Free Wifi","Mini Bar"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_updated_date
			(
    			type = date
				displayname = "Last Updated Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			maintenance_notes
			(
    			type = textarea
				displayname = "Maintenance Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Room Created","Room Available","Room Under Maintenance","Room Booked","Room Out of Order","Room Occupied","Room Inventory Updated"}
			}
		}
	}
	reports
	{
		list Room_Booking_Form_Report
		{
			displayName = "Room Booking Form Report"
			show all rows from Room_Booking_Form    
			(
				Guest_Name  as "Guest Name"
				Permanent_Address  as "Permanent Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Email_Address as "Email Address"
				Contact_Number as "Contact Number"
				ID_Proof_Number as "ID Proof Number"
				Special_Requests as "Special Requests"
				Number_Of_Guests as "Number Of Guests"
				Check_In_Date as "Check In Date"
				Preferred_Checkin_Time as "Preferred Checkin Time"
				Room_Type as "Room Type"
				Meal_Plan as "Meal Plan"
				Amenities_Required as "Amenities Required"
				Agree_To_Hotel_Policies as "Agree To Hotel Policies"
				Requires_Airport_Pickup as "Requires Airport Pickup"
				Hotel_Policies_Display as "Hotel Policies Display"
				Travel_Itinerary_URL as "Travel Itinerary URL"
				Guest_Photo as "Guest Photo"
				Loyalty_Discount_Percent as "Loyalty Discount Percent"
				(
					display = total,average,min,max	
				)
				Advance_Payment_Paid as "Advance Payment Paid"
				(
					display = total,average,min,max	
				)
				Distance_From_Airport_KM as "Distance From Airport KM"
				Booking_Submitted_On as "Booking Submitted On"
				Additional_Guests_Details as "Additional Guests Details"
				Room_Type_Availability_Lookup as "Room Type Availability Lookup"
				Guest_Digital_Signature as "Guest Digital Signature"
				ID_Proof_Upload as "ID Proof Upload"
				Special_Request_Voice_Note as "Special Request Voice Note"
				Celebration_Request_Video as "Celebration Request Video"
				Booking_ID as "Booking ID"
				Total_Amount_Payable as "Total Amount Payable"
				(
					display = total,average,min,max	
				)
				Booking_Confirmation_QR_Code as "Booking Confirmation QR Code"
			)
		}
		kanban Room_Booking_Form_by_Room_Type
		{
			displayName = "Room Types"
			show all rows from Room_Booking_Form    
			(
				Guest_Name  as "Guest Name"
				Permanent_Address  as "Permanent Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Email_Address as "Email Address"
				Contact_Number as "Contact Number"
				ID_Proof_Number as "ID Proof Number"
				Special_Requests as "Special Requests"
				Number_Of_Guests as "Number Of Guests"
				Check_In_Date as "Check In Date"
				Preferred_Checkin_Time as "Preferred Checkin Time"
				Room_Type as "Room Type"
				Meal_Plan as "Meal Plan"
				Amenities_Required as "Amenities Required"
				Agree_To_Hotel_Policies as "Agree To Hotel Policies"
				Requires_Airport_Pickup as "Requires Airport Pickup"
				Hotel_Policies_Display as "Hotel Policies Display"
				Travel_Itinerary_URL as "Travel Itinerary URL"
				Guest_Photo as "Guest Photo"
				Loyalty_Discount_Percent as "Loyalty Discount Percent"
				(
					display = total,average,min,max	
				)
				Advance_Payment_Paid as "Advance Payment Paid"
				(
					display = total,average,min,max	
				)
				Distance_From_Airport_KM as "Distance From Airport KM"
				Booking_Submitted_On as "Booking Submitted On"
				Additional_Guests_Details as "Additional Guests Details"
				Room_Type_Availability_Lookup as "Room Type Availability Lookup"
				Guest_Digital_Signature as "Guest Digital Signature"
				ID_Proof_Upload as "ID Proof Upload"
				Special_Request_Voice_Note as "Special Request Voice Note"
				Celebration_Request_Video as "Celebration Request Video"
				Booking_ID as "Booking ID"
				Total_Amount_Payable as "Total Amount Payable"
				(
					display = total,average,min,max	
				)
				Booking_Confirmation_QR_Code as "Booking Confirmation QR Code"
			)
			options
			(
	 			display field = Room_Type
	 		)
		}
		list Room_Inventory_Report
		{
			displayName = "All Room Inventories"
			show all rows from Room_Inventory    
			(
				room_type_code as "Room Type Code"
				room_type_name as "Room Type Name"
				tariff_per_night as "Tariff Per Night"
				(
					display = total,average,min,max	
				)
				availability_status as "Availability Status"
				room_number as "Room Number"
				floor as "Floor"
				max_occupancy as "Max Occupancy"
				amenities_list as "Amenities List"
				last_updated_date as "Last Updated Date"
				maintenance_notes as "Maintenance Notes"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (room_type_name == "Deluxe Double Room")
				fields = [room_type_name]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (room_type_name == "Standard Single Room")
				fields = [room_type_name]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban Room_Inventory_by_room_type_name
		{
			displayName = "Room Type Names"
			show all rows from Room_Inventory    
			(
				room_type_code as "Room Type Code"
				room_type_name as "Room Type Name"
				tariff_per_night as "Tariff Per Night"
				(
					display = total,average,min,max	
				)
				availability_status as "Availability Status"
				room_number as "Room Number"
				floor as "Floor"
				max_occupancy as "Max Occupancy"
				amenities_list as "Amenities List"
				last_updated_date as "Last Updated Date"
				maintenance_notes as "Maintenance Notes"
			)
			options
			(
	 			display field = room_type_name
	 		)
		}
	}
	pages
	{
		page DashBoard
		{
			displayname = "Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='25%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = 'transparent'\n\n\t\twidth = '50%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\t\thAlign = 'left'\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#3F3F3F'\n\tsize = '24px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\n\tdisplayType = 'actual'\n\tdecimalPlaces = '2'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t  value = 'thisapp.Room_Booking_Form.Total_Amount_Payable.sum'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#909090'\n\tsize = '14px'\n\ttype = 'Text'\n\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\n\n\n\n\n\t  value = 'Total Amount Payable'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc><pc \n\t\tpadding = '20px'\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\t\twidth = '50%'\n\t\thAlign = 'right'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '10px'\n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n\tcolor = '#FFFFFF'\n\tbgColor = 'theme'\n\twidth = '40px'\n\theight = '40px'\n\ttype = 'icon'\n\tvalue = 'business-calculator'\n\tsize = '22px'\n\tcornerRadius = '10px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='23%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColo