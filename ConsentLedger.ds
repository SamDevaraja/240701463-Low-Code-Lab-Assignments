 * Version      : 1.0
 */
 application "ConsentLedger"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Action_Log
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Action_Reference_ID
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Action_Date_Time
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_Type
			(
				type = picklist
				maxchar = 100
				values = {"Created","Updated","Assigned","Withdrawn","Completed","Escalated"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Related_Record_Type
			(
				type = picklist
				maxchar = 100
				values = {"Consent","Rights Request","Incident","Configuration"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Related_Record_ID
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Performed_By
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_Details
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Breach_Incidents
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Incident_Reference_ID
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Incident_Title
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Incident_Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Discovery_Date_Time
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Severity
			(
				type = picklist
				maxchar = 100
				values = {"Low","Medium","High","Critical"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Affected_Records_Estimate
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Incident_Status
			(
				type = picklist
				maxchar = 100
				values = {"Reported","Investigating","Contained","Resolved","Closed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Assigned_Officer
			(
    			type = picklist
				module = users
				displayformat = [username]
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Response_Due_Date_Time
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk_Score
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk_Category_Prediction
			(
    			type = text
				displayname = "Risk_Category Prediction"
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = Prediction
									modelname = "ConsentLedger_Breach_Risk_v2"
									supportingfield = {Affected_Records_Estimate,Severity}
						)
			)
			Resolution_Summary
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Consent_Records
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Consent_Reference_ID
			(
    			type = text
				displayname = "Consent Reference ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Person
			(
				type = picklist	
				values  = Person_Register.ID
    			displayformat = [Full_Name.last_name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Purpose
			(
				type = picklist
				maxchar = 100
				values = {"Service Delivery","Marketing","Analytics","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Notice_Version
			(
    			type = text
				displayname = "Notice Version"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Consent_Status
			(
				type = picklist
				displayname = "Consent Status"
				maxchar = 100
				values = {"Granted","Withdrawn","Not Granted"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Consent_Date_Time
			(
    			type = datetime
				displayname = "Consent Date Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Withdrawal_Date_Time
			(
    			type = datetime
				displayname = "Withdrawal Date Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Source
			(
				type = picklist
				maxchar = 100
				values = {"Web Form","Mobile App","Manual Entry","API"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Event_Notes
			(
    			type = textarea
				displayname = "Event Notes"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Consent_Document
			(
    			type = upload file
				displayname = "Consent Document"
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			OCR
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = OCR
									basefield = Consent_Document
						)
			)
			OCR_Review_Status
			(
				type = picklist
				displayname = "OCR Review Status"
				maxchar = 100
				values = {"Not Started","Needs Review","Verified","Rejected"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Person_Register
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Full_Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Email_Address
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Phone_Number1
			(
    			type = phonenumber
				displayname = "Phone_Number"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Person_Reference_ID
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Relationship_Type
			(
				type = picklist
				maxchar = 100
				values = {"Customer","Employee"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Record_Status1
			(
				type = picklist
				displayname = "Record_Status"
				maxchar = 100
				values = {"Active","Inactive"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Rights_Requests
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Request_Reference_ID
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Person
			(
				type = picklist	
				values  = Person_Register.ID
    			displayformat = [Full_Name.last_name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Request_Type
			(
				type = picklist
				maxchar = 100
				values = {"Access","Correction","Erasure","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Request_Text
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			AI_Suggested_Type
			(
				type = picklist
				maxchar = 100
				values = {"Access","Correction","Erasure","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Classification_Status
			(
				type = picklist
				maxchar = 100
				values = {"Pending Review","Confirmed","Corrected"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Request_Status
			(
				type = picklist
				maxchar = 100
				values = {"Received","Under Review","In Progress","Completed","Rejected","Closed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Request_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Due_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Delay_Risk_Level
			(
				type = picklist
				maxchar = 100
				values = {"Not Assessed","Low","Medium","High"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk_Reason
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Assigned_To
			(
    			type = picklist
				module = users
				displayformat = [username]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resolution_Notes
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Completion_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Rule_Configuration
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Rule_Name
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Rule_Category
			(
				type = picklist
				maxchar = 100
				values = {"Request Deadline","Reminder","Escalation","Incident Response"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Rule_Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Duration_Value
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Duration_Unit
			(
				type = picklist
				maxchar = 100
				values = {"Hours","Days"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reminder_Lead_Time
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Escalation_Enabled
			(
				type = checkboxes	
				values = {"Enable","Disable"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Is_Active
			(
				type = checkboxes	
				values = {"Enable","Disable"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Person_Register_Report
		{
			displayName = "Person_Register Report"
			show all rows from Person_Register    
			(
				Full_Name 
				Email_Address
				Phone_Number1 as "Phone_Number"
				(
					displayformat = plainnumber 
				)
				Person_Reference_ID
				Relationship_Type
				Record_Status1 as "Record_Status"
				Notes
			)
		}
		default list Consent_Records_Report
		{
			displayName = "Consent_Records Report"
			show all rows from Consent_Records    
			(
				OCR
			)
		}
		list Consent_Records_List
		{
			displayName = "Consent Records List"
			show all rows from Consent_Records    
			(
				Consent_Reference_ID as "Consent Reference ID"
				Person
				Purpose
				Notice_Version as "Notice Version"
				Consent_Status as "Consent Status"
				Consent_Date_Time as "Consent Date Time"
				Withdrawal_Date_Time as "Withdrawal Date Time"
				Source
				Event_Notes as "Event Notes"
				Consent_Document as "Consent Document"
				OCR_Review_Status as "OCR Review Status"
			)
			sort by
			(
				Consent_Date_Time descending
			)
		}
		list Rights_Requests_List
		{
			displayName = "Rights Requests List"
			show all rows from Rights_Requests    
			(
				Request_Reference_ID
				Person
				Request_Text
				Request_Type
				AI_Suggested_Type
				Classification_Status
				Request_Date
				Request_Status
				Assigned_To
				Due_Date
				Completion_Date
				Delay_Risk_Level
				Risk_Reason
				Resolution_Notes
			)
			sort by
			(
				Delay_Risk_Level descending
			)
		}
		default list Breach_Incidents_Report
		{
			displayName = "Breach_Incidents Report"
			show all rows from Breach_Incidents    
			(
				Incident_Reference_ID
				Incident_Title
				Incident_Description
				Discovery_Date_Time
				Severity
				Incident_Status
				Affected_Records_Estimate
				Assigned_Officer
				Response_Due_Date_Time
				Resolution_Summary
				Risk_Score
				Risk_Category_Prediction as "Risk_Category Prediction"
			)
		}
		default list Action_Log_Report
		{
			displayName = "Action_Log Report"
			show all rows from Action_Log    
			(
				Action_Reference_ID
				Action_Date_Time
				Performed_By
				Action_Type
				Related_Record_Type
				Related_Record_ID
				Action_Details
			)
			sort by
			(
				Action_Reference_ID ascending
			)
		}
		default list Rule_Configuration_Report
		{
			displayName = "Rule_Configuration Report"
			show all rows from Rule_Configuration    
			(
				Rule_Name
				Rule_Category
				Duration_Value
				Duration_Unit
				Reminder_Lead_Time
				Escalation_Enabled
				Is_Active
				Rule_Description
			)
		}
	}
	pages
	{
		page ConsentLedger_Dashboard
		{
