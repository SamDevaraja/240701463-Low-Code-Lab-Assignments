		}
	}




		workflow
		{
		form
		{
			auto_calculate_total_amount as "Auto-calculate Total Amount"
			{
				type =  form
				form = Room_Booking_Form

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the room inventory record based on the selected room type
										roomInventoryRecords = Room_Inventory[room_type_name == input.Room_Type];
										// Check if room inventory record exists
										if(roomInventoryRecords.count() > 0)
										{
											// Get the tariff per night from the first matching record
											tariffPerNight = roomInventoryRecords.tariff_per_night;
											// Get the number of guests
											numberOfGuests = input.Number_Of_Guests;
											// Calculate total amount payable (tariff * number of guests)
											totalAmount = tariffPerNight * numberOfGuests;
											// Set the total amount payable field
											input.Total_Amount_Payable = totalAmount;
										}
										else
										{
											// Clear the total amount if no room type is selected or room not found
											input.Total_Amount_Payable = 0;
										}
						)
					}
				}

			}
			validate_airport_pickup_logic as "Validate Airport Pickup Logic"
			{
				type =  form
				form = Room_Booking_Form

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if airport pickup is requested
										if(input.Requires_Airport_Pickup == true)
										{
											// Validate that distance from airport is provided
											if(input.Distance_From_Airport_KM.isNull() || input.Distance_From_Airport_KM.isEmpty())
											{
												alert "Airport pickup is requested but distance from airport is not provided. Please enter the distance.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			send_booking_confirmation_email as "Send Booking Confirmation Email"
			{
				type =  form
				form = Room_Booking_Form

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the submitted booking record to access all field values
										bookingRecord = Room_Booking_Form[Booking_ID == input.Booking_ID];
										// Validate that the booking record exists
										if(bookingRecord.isNull())
										{
											info "Booking record not found";
											return;
										}
										// Extract guest email address
										guestEmail = bookingRecord.Email_Address;
										// Validate email address exists
										if(guestEmail.isNull() || guestEmail.isEmpty())
										{
											info "Guest email address is missing";
											return;
										}
										// Extract guest name from composite NAME field
										guestName = bookingRecord.Guest_Name.first_name;
										if(guestName.isNull() || guestName.isEmpty())
										{
											guestName = "Guest";
										}
										// Extract booking ID
										bookingID = bookingRecord.Booking_ID;
										// Extract QR code
										qrCode = bookingRecord.Booking_Confirmation_QR_Code;
										// Extract check-in date
										checkInDate = bookingRecord.Check_In_Date;
										// Extract room type
										roomType = bookingRecord.Room_Type;
										// Extract number of guests
										numberOfGuests = bookingRecord.Number_Of_Guests;
										// Extract total amount payable
										totalAmount = bookingRecord.Total_Amount_Payable;
										// Format the email message
										emailSubject = "Booking Confirmation - Booking ID: " + bookingID.toString();
										emailMessage = "<html><body>";
										emailMessage = emailMessage.concat("<h2>Dear ").concat(guestName).concat(",</h2>");
										emailMessage = emailMessage.concat("<p>Thank you for your booking!</p>");
										emailMessage = emailMessage.concat("<p><strong>Booking Details:</strong></p>");
										emailMessage = emailMessage.concat("<ul>");
										emailMessage = emailMessage.concat("<li><strong>Booking ID:</strong> ").concat(bookingID.toString()).concat("</li>");
										emailMessage = emailMessage.concat("<li><strong>Check-in Date:</strong> ").concat(checkInDate.toString()).concat("</li>");
										emailMessage = emailMessage.concat("<li><strong>Room Type:</strong> ").concat(roomType).concat("</li>");
										emailMessage = emailMessage.concat("<li><strong>Number of Guests:</strong> ").concat(numberOfGuests.toString()).concat("</li>");
										emailMessage = emailMessage.concat("<li><strong>Total Amount Payable:</strong> ").concat(totalAmount.toString()).concat("</li>");
										emailMessage = emailMessage.concat("</ul>");
										if(qrCode.isNull() || qrCode.isEmpty())
										{
											emailMessage = emailMessage.concat("<p><em>Your QR code will be sent separately.</em></p>");
										}
										else
										{
											emailMessage = emailMessage.concat("<p><strong>Booking QR Code:</strong></p>");
											emailMessage = emailMessage.concat("<p>").concat(qrCode).concat("</p>");
										}
										emailMessage = emailMessage.concat("<p>We look forward to welcoming you!</p>");
										emailMessage = emailMessage.concat("<p>Best regards,<br>Hotel Management Team</p>");
										emailMessage = emailMessage.concat("</body></html>");
										// Send the confirmation email
										sendmail
										[
											from :zoho.loginuserid
											to :guestEmail
											subject :emailSubject
											message :emailMessage
											content type :HTML
										]
										info "Booking confirmation email sent successfully to " + guestEmail;
						)
					}
				}

			}
		}

		schedule
		{
			daily_room_availability_check as "Daily Room Availability Check"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch rooms that need maintenance from Room_Inventory form
										maintenanceRooms = Room_Inventory[availability_status == "Maintenance"];
										// Check if there are any rooms needing maintenance
										if(maintenanceRooms.count() > 0)
										{
											// Build notification message
											notificationMessage = "The following rooms require maintenance:\n\n";
											for each  room in maintenanceRooms
											{
												notificationMessage = notificationMessage.concat("Room Number: ").concat(room.room_number.toString()).concat(" - ").concat(room.room_type_name.toString()).concat("\n");
												if(!room.maintenance_notes.isNull())
												{
													notificationMessage = notificationMessage.concat("Notes: ").concat(room.maintenance_notes).concat("\n");
												}
												notificationMessage = notificationMessage.concat("------------------------\n");
											}
											// Send email notification to front office
											sendmail
											[
												from :zoho.loginuserid
												to :zoho.adminuserid
												subject :"Daily Maintenance Alert - Rooms Requiring Attention"
												message :notificationMessage
												content type :Plain Text
											]
										}
					)
					}
				}
			}
		}


